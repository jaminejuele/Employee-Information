import sqlite3
import tkinter as tk
from tkinter import ttk, messagebox

conn = sqlite3.connect("students.db")
cursor = conn.cursor()

cursor.execute("""
CREATE TABLE IF NOT EXISTS students (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    age INTEGER NOT NULL,
    course TEXT NOT NULL
)
""")

conn.commit()


root = tk.Tk()
root.title("Employee Information System")
root.geometry("700x500")

def add_employee():
    name = name_entry.get()
    age = age_entry.get()
    position = position_entry.get()

    if name == "" or age == "" or position == "":
        messagebox.showwarning("Warning", "Please fill in all fields.")
        return

    if not age.isdigit():
        messagebox.showwarning("Warning", "Age must be a number.")
        return

    employee_table.insert(
        "",
        "end",
        values=(name, age, position)
    )

    clear_fields()
    messagebox.showinfo("Success", "Employee added successfully!")


def select_employee(event):
    selected = employee_table.selection()

    if selected:
        values = employee_table.item(selected[0], "values")

        name_entry.delete(0, tk.END)
        name_entry.insert(0, values[0])

        age_entry.delete(0, tk.END)
        age_entry.insert(0, values[1])

        position_entry.delete(0, tk.END)
        position_entry.insert(0, values[2])


def update_employee():
    selected = employee_table.selection()

    if not selected:
        messagebox.showwarning(
            "Warning",
            "Please select an employee to update."
        )
        return

    name = name_entry.get()
    age = age_entry.get()
    position = position_entry.get()

    if name == "" or age == "" or position == "":
        messagebox.showwarning(
            "Warning",
            "Please fill in all fields."
        )
        return

    if not age.isdigit():
        messagebox.showwarning(
            "Warning",
            "Age must be a number."
        )
        return

    employee_table.item(
        selected[0],
        values=(name, age, position)
    )

    clear_fields()
    messagebox.showinfo(
        "Success",
        "Employee updated successfully!"
    )


def delete_employee():
    selected = employee_table.selection()

    if not selected:
        messagebox.showwarning(
            "Warning",
            "Please select an employee to delete."
        )
        return

    confirm = messagebox.askyesno(
        "Confirm Delete",
        "Are you sure you want to delete this employee?"
    )

    if confirm:
        employee_table.delete(selected[0])
        clear_fields()
        messagebox.showinfo(
            "Success",
            "Employee deleted successfully!"
        )


def clear_fields():
    name_entry.delete(0, tk.END)
    age_entry.delete(0, tk.END)
    position_entry.delete(0, tk.END)

    employee_table.selection_remove(
        employee_table.selection()
    )

def exit_fields():
    root.destroy()

#GUI
title_label = tk.Label(
    root,
    text="EMPLOYEE INFORMATION",
    font=("Times Neew Roman", 20, "bold"),
    bg="#EAF4FB",
    fg="black",
    pady=15
)


title_label.pack(fill="x")
input_frame = tk.Frame(root, padx=20, pady=20)
input_frame.pack(fill="x")


# Name
tk.Label(
    input_frame,
    text="Name:",
    font=("Arial", 12)
).grid(row=0, column=0, padx=10, pady=8)

name_entry = tk.Entry(
    input_frame,
    font=("Arial", 12),
    width=30
)
name_entry.grid(row=0, column=1, padx=10, pady=8)


# Age
tk.Label(
    input_frame,
    text="Age:",
    font=("Arial", 12)
).grid(row=1, column=0, padx=10, pady=8)

age_entry = tk.Entry(
    input_frame,
    font=("Arial", 12),
    width=30
)
age_entry.grid(row=1, column=1, padx=10, pady=8)


# Position
tk.Label(
    input_frame,
    text="Position:",
    font=("Arial", 12)
).grid(row=2, column=0, padx=10, pady=8)

position_entry = tk.Entry(
    input_frame,
    font=("Arial", 12),
    width=30
)
position_entry.grid(row=2, column=1, padx=10, pady=8)

button_frame = tk.Frame(root)
button_frame.pack(pady=5)


TITLE_COLOR = "#154360"
LABEL_COLOR = "#1F618D"
ENTRY_BG = "#FFFFFF"

ADD_COLOR = "#27AE60"
UPDATE_COLOR = "#F39C12"
DELETE_COLOR = "#E74C3C"
CLEAR_COLOR = "#7F8C8D"

#Button
tk.Button(
    button_frame,
    text="Add",
    width=12,
    bg="#27ae60",
    fg="black",
    font=("Arial", 11, "bold"),
    command=add_employee
).grid(row=0, column=0, padx=5)

tk.Button(
    button_frame,
    text="Update",
    width=12,
    bg="#F39C12",
    fg="black",
    font=("Arial", 11, "bold"),
    command=update_employee
).grid(row=0, column=1, padx=5)

tk.Button(
    button_frame,
    text="Delete",
    width=12,
    bg="#E74C3C",
    fg="black",
    font=("Arial", 11, "bold"),
    command=delete_employee
).grid(row=0, column=2, padx=5)

tk.Button(
    button_frame,
    text="Clear",
    width=12,
    bg="#7F8C8D",
    fg="black",
    font=("Arial", 11, "bold"),
    command=clear_fields
).grid(row=0, column=3, padx=5)

tk.Button(
    button_frame,
    text="Exit",
    width=12,
    bg="#27AE60",
    fg="black",
    font=("Arial", 11, "bold"),
    command=clear_fields
).grid(row=0, column=4, padx=5)


table_frame = tk.Frame(root, padx=20, pady=15)
table_frame.pack(fill="both", expand=True)

columns = ("Name", "Age", "Position")

employee_table = ttk.Treeview(
    table_frame,
    columns=columns,
    show="headings",
    height=8
)

employee_table.heading("Name", text="Name")
employee_table.heading("Age", text="Age")
employee_table.heading("Position", text="Position")

employee_table.column("Name", width=250)
employee_table.column("Age", width=100, anchor="center")
employee_table.column("Position", width=250)

employee_table.pack(fill="both", expand=True)

employee_table.bind(
    "<ButtonRelease-1>",
    select_employee
)


root.mainloop()

